rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Amministratore principale (non revocabile)
    function isSuper() {
      return signedIn()
        && request.auth.token.email == 'nicola.vacca@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Amministratori promossi dal pannello Utenti
    function isAdmin() {
      return isSuper()
        || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Giocatori: tutti leggono i nomi, solo gli admin li modificano
    match /players/{playerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Utenti che hanno fatto login: ognuno scrive solo il proprio profilo
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'name', 'lastLogin', 'createdAt']);
      allow delete: if isAdmin();
    }

    // Elenco amministratori
    match /admins/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list, write: if isAdmin();
    }

    // Voti alle skill: PRIVATI. Li legge solo chi li ha dati e gli admin.
    match /votes/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['ratings', 'updatedAt'])
        && request.resource.data.ratings is map
        && request.resource.data.ratings.size() <= 300;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Stato generale (partita in corso)
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Partite: formazioni pubblicate e risultati
    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      // Voti alle formazioni: uno per utente, solo con votazione aperta
      match /fvotes/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['choice', 'at'])
          && request.resource.data.choice is int
          && request.resource.data.choice >= 0
          && request.resource.data.choice < 10
          && get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'voting';
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    // Tutto il resto: solo gli amministratori (serve anche per ripulire dati vecchi)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
